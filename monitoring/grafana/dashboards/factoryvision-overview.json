      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(factoryvision_predictions_total{outcome=\"defect\"}[5m])) / clamp_min(sum(rate(factoryvision_predictions_total{outcome=~\"defect|no_defect\"}[5m])), 1e-9)",
          "legendFormat": "predicted defect rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Predicted defect rate",
      "type": "gauge"
    },
    {
