# Local learning instructions; keep them out of the public repository.
instructions.md
factoryvision-notion.md
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Local DVC cache and temporary metadata.
.dvc/cache/
.dvc/site-cache/
.dvc/tmp/

# Dataset files are tracked through the DVC pointer file, not Git.
data/raw/kolektor-sdd2/
data/raw/*.zip

# Local DVC remote; do not commit the remote's data objects to Git.
data/dvc-remote/

# Generated training runs and model checkpoints.
artifacts/
spark-warehouse/

# Airflow runtime logs and local batch hand-off files.
airflow/logs/
data/batch/incoming/*
!data/batch/incoming/.gitkeep
